[sub_resource type="GDScript" id="GDScript_tiu2u"]
script/source = "extends Area2D

@export var timer: Timer
@export var animation_player: AnimationPlayer
@export var sprite: Sprite2D

var ativada = false

func _ready():
	print(\"--- Mina Pronta ---\") # Verifica se a mina foi carregada

# Esta função é chamada pelo sinal \"body_entered\"
func _on_body_entered(body):
	
	# PRINT 1: A DETECÇÃO ESTÁ FUNCIONANDO?
	# Você verá isso no console toda vez que *qualquer coisa* tocar a mina.
	print(\"ALGO ENTROU NA MINA! O nome é: \", body.name)

	if ativada:
		return
		
	# PRINT 2: A CONDIÇÃO IF ESTÁ FUNCIONANDO?
	print(\"Checando se o corpo '\", body.name, \"' está no grupo 'Bigo'...\")
	print(\"Resultado: \", body.is_in_group(\"Bigo\"))
	
	if (body.name == \"Bigo\") or (body.name == \"Marina\") or (body.name == \"Rafinha\"):
		
		# PRINT 3: A MINA FOI ATIVADA?
		print(\"!!! SUCESSO! Mina ativada pelo Bigo! Iniciando timer... !!!\")
		body.queue_free()
		ativada = true		
		timer.start()

# Esta função é chamada pelo sinal \"timeout\" do Timer
func _on_timer_timeout(): # <-- ATENÇÃO AQUI! O 'T' é maiúsculo?
	
	# PRINT 4: O TIMER FUNCIONOU?
	print(\"!!! KABOOM! Timer zerou, tocando explosão! !!!\")
	
	animation_player.play(\"Explodir\")
	#Sumir com o BIgo

	
	#var corpos_na_area = get_overlapping_bodies()
	#for body in corpos_na_area:
	#	if body.is_in_group(\"Bigo\"):
	#		if body.has_method(\"levar_dano\"):
	#			body.levar_dano(100)
"

